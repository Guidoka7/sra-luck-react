{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sra-luck-api",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-10",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
