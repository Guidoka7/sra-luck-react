# Frontend Vite (public values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_REVIEW_URL=

# Cloudflare Worker secrets — configure with `wrangler secret put` / `.dev.vars` locally.
# NEVER expose these as VITE_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLIENTE_SESSION_SECRET=
PUBLIC_APP_URL=http://localhost:5173

# RD Station CRM
# Configure o webhook com header customizado apontando para RD_WEBHOOK_SECRET.
RD_WEBHOOK_SECRET=
RD_API_ACCESS_TOKEN=

# Conta Azul (OAuth 2.0)
CONTA_AZUL_CLIENT_ID=
CONTA_AZUL_CLIENT_SECRET=
CONTA_AZUL_ACCESS_TOKEN=
CONTA_AZUL_REFRESH_TOKEN=

# Mercado Pago Checkout Pro
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Webhook secrets / tokens dos bancos — nomes reservados; valor/formato dependem da homologação de cada instituição.
BRB_WEBHOOK_SECRET=
BB_WEBHOOK_SECRET=
SANTANDER_WEBHOOK_SECRET=
SICREDI_WEBHOOK_SECRET=
EFI_WEBHOOK_SECRET=

# Notifications Worker secrets / configuration
NOTIFICACOES_APP_URL=http://localhost:5173
NOTIFICACOES_CRON_SECRET=troque-por-um-segredo-forte
WEB_PUSH_VAPID_SUBJECT=mailto:seu-email@exemplo.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
