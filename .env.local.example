# Supabase - encontre em Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chave secreta para assinar a sessao do login da cliente (cpf + nascimento)
# Gere qualquer string longa e aleatoria, ex: openssl rand -hex 32
CLIENTE_SESSION_SECRET=

# Worker de notificações automáticas
NOTIFICACOES_APP_URL=http://localhost:3000
NOTIFICACOES_CRON_SECRET=troque-por-um-segredo-forte

# Web Push / notificações do sistema no celular
# Gere as chaves com: npm run gerar-vapid
WEB_PUSH_VAPID_SUBJECT=mailto:seu-email@exemplo.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Link direto do Perfil da Empresa no Google para publicar uma avaliação.
# Exemplo: https://search.google.com/local/writereview?placeid=SEU_PLACE_ID
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
