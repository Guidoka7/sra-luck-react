# Frontend Vite (public values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_REVIEW_URL=
# Site key pública do Cloudflare Turnstile. Pode ser VITE_*.
VITE_TURNSTILE_SITE_KEY=

# Cloudflare Worker secrets — configure com `wrangler secret put` / `.dev.vars` localmente.
# NUNCA exponha estas variáveis como VITE_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLIENTE_SESSION_SECRET=

# Chaves de segurança separadas. Em produção use valores aleatórios distintos.
LOG_PSEUDONYM_KEY=
INTEGRATION_ENCRYPTION_KEY=
TURNSTILE_SECRET_KEY=
# Produção: true. Local/dev pode permanecer false enquanto o widget não estiver configurado.
TURNSTILE_REQUIRED=false

# Em produção use somente https:// no domínio oficial.
PUBLIC_APP_URL=http://localhost:5173

# RD Station CRM
RD_WEBHOOK_SECRET=
RD_API_ACCESS_TOKEN=
RD_CLIENT_ID=
RD_CLIENT_SECRET=
RD_REDIRECT_URI=
RD_ACCESS_TOKEN=
RD_REFRESH_TOKEN=
RD_TOKEN_EXPIRES_AT=

# Conta Azul (OAuth 2.0)
CONTA_AZUL_CLIENT_ID=
CONTA_AZUL_CLIENT_SECRET=
CONTA_AZUL_ACCESS_TOKEN=
CONTA_AZUL_REFRESH_TOKEN=

# Mercado Pago Checkout Pro
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Webhook secrets / tokens dos bancos — nomes reservados; valor/formato dependem da homologação de cada instituição.
BRB_WEBHOOK_SECRET=
BB_WEBHOOK_SECRET=
SANTANDER_WEBHOOK_SECRET=
SICREDI_WEBHOOK_SECRET=
EFI_WEBHOOK_SECRET=

# Notifications Worker secrets / configuration
NOTIFICACOES_APP_URL=http://localhost:5173
NOTIFICACOES_CRON_SECRET=
WEB_PUSH_VAPID_SUBJECT=mailto:seu-email@exemplo.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
