# =============================================================================
# SRA. LUCK — VARIÁVEIS DE AMBIENTE
# Copie para .env.local apenas no desenvolvimento. Em produção use secrets do
# Cloudflare/Netlify. Nunca faça commit de valores reais.
# =============================================================================

# Frontend Vite — somente valores públicos
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_REVIEW_URL=

# Worker — nunca usar prefixo VITE_
SUPABASE_URL=
SUPABASE_POOLER_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLIENTE_SESSION_SECRET=
PUBLIC_APP_URL=http://localhost:5173
SENTRY_DSN=

# mock = roda sem credenciais externas; live = usa providers reais
INTEGRATION_MODE=mock

# RD Station
RD_STATION_API_KEY=
RD_STATION_WEBHOOK_TOKEN=
RD_STATION_BASE_URL=https://api.rd.services
RD_STATION_UPSERT_PATH=/platform/contacts

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_TOKEN=
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com

# Conta Azul
CONTA_AZUL_API_KEY=
CONTA_AZUL_WEBHOOK_TOKEN=
CONTA_AZUL_BASE_URL=
CONTA_AZUL_CREATE_RECEIVABLE_PATH=
CONTA_AZUL_GET_RECEIVABLE_PATH=

# Bancos — credenciais solicitadas
BANCO_BRB_API_KEY=
BANCO_BB_API_KEY=
BANCO_SANTANDER_API_KEY=
BANCO_SICREDI_API_KEY=
BANCO_EFI_API_KEY=

# Bancos — configuração de adapter. Permite homologar sem alterar código.
# AUTH_MODE: api_key | bearer | oauth2_client_credentials
BANCO_BRB_BASE_URL=
BANCO_BRB_AUTH_MODE=api_key
BANCO_BRB_API_KEY_HEADER=x-api-key
BANCO_BRB_TOKEN_URL=
BANCO_BRB_CLIENT_ID=
BANCO_BRB_CLIENT_SECRET=
BANCO_BRB_SCOPE=
BANCO_BRB_CREATE_CHARGE_PATH=/charges
BANCO_BRB_GET_CHARGE_PATH=/charges/{id}
BANCO_BRB_WEBHOOK_TOKEN=

BANCO_BB_BASE_URL=
BANCO_BB_AUTH_MODE=api_key
BANCO_BB_API_KEY_HEADER=x-api-key
BANCO_BB_TOKEN_URL=
BANCO_BB_CLIENT_ID=
BANCO_BB_CLIENT_SECRET=
BANCO_BB_SCOPE=
BANCO_BB_CREATE_CHARGE_PATH=/charges
BANCO_BB_GET_CHARGE_PATH=/charges/{id}
BANCO_BB_WEBHOOK_TOKEN=

BANCO_SANTANDER_BASE_URL=
BANCO_SANTANDER_AUTH_MODE=api_key
BANCO_SANTANDER_API_KEY_HEADER=x-api-key
BANCO_SANTANDER_TOKEN_URL=
BANCO_SANTANDER_CLIENT_ID=
BANCO_SANTANDER_CLIENT_SECRET=
BANCO_SANTANDER_SCOPE=
BANCO_SANTANDER_CREATE_CHARGE_PATH=/charges
BANCO_SANTANDER_GET_CHARGE_PATH=/charges/{id}
BANCO_SANTANDER_WEBHOOK_TOKEN=

BANCO_SICREDI_BASE_URL=
BANCO_SICREDI_AUTH_MODE=api_key
BANCO_SICREDI_API_KEY_HEADER=x-api-key
BANCO_SICREDI_TOKEN_URL=
BANCO_SICREDI_CLIENT_ID=
BANCO_SICREDI_CLIENT_SECRET=
BANCO_SICREDI_SCOPE=
BANCO_SICREDI_CREATE_CHARGE_PATH=/charges
BANCO_SICREDI_GET_CHARGE_PATH=/charges/{id}
BANCO_SICREDI_WEBHOOK_TOKEN=

BANCO_EFI_BASE_URL=
BANCO_EFI_AUTH_MODE=api_key
BANCO_EFI_API_KEY_HEADER=x-api-key
BANCO_EFI_TOKEN_URL=
BANCO_EFI_CLIENT_ID=
BANCO_EFI_CLIENT_SECRET=
BANCO_EFI_SCOPE=
BANCO_EFI_CREATE_CHARGE_PATH=/charges
BANCO_EFI_GET_CHARGE_PATH=/charges/{id}
BANCO_EFI_WEBHOOK_TOKEN=

# Campos de resposta dos adapters bancários, se a homologação usar nomes diferentes
BANCO_BRB_FIELD_ID=id
BANCO_BRB_FIELD_STATUS=status
BANCO_BRB_FIELD_BARCODE=barcode
BANCO_BRB_FIELD_DIGITABLE_LINE=digitable_line
BANCO_BRB_FIELD_PAYMENT_URL=payment_url
BANCO_BB_FIELD_ID=id
BANCO_BB_FIELD_STATUS=status
BANCO_BB_FIELD_BARCODE=barcode
BANCO_BB_FIELD_DIGITABLE_LINE=digitable_line
BANCO_BB_FIELD_PAYMENT_URL=payment_url
BANCO_SANTANDER_FIELD_ID=id
BANCO_SANTANDER_FIELD_STATUS=status
BANCO_SANTANDER_FIELD_BARCODE=barcode
BANCO_SANTANDER_FIELD_DIGITABLE_LINE=digitable_line
BANCO_SANTANDER_FIELD_PAYMENT_URL=payment_url
BANCO_SICREDI_FIELD_ID=id
BANCO_SICREDI_FIELD_STATUS=status
BANCO_SICREDI_FIELD_BARCODE=barcode
BANCO_SICREDI_FIELD_DIGITABLE_LINE=digitable_line
BANCO_SICREDI_FIELD_PAYMENT_URL=payment_url
BANCO_EFI_FIELD_ID=id
BANCO_EFI_FIELD_STATUS=status
BANCO_EFI_FIELD_BARCODE=barcode
BANCO_EFI_FIELD_DIGITABLE_LINE=digitable_line
BANCO_EFI_FIELD_PAYMENT_URL=payment_url

# Notificações
NOTIFICACOES_APP_URL=http://localhost:5173
NOTIFICACOES_CRON_SECRET=
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Setup local opcional para migrations/seed via psql
SUPABASE_DB_URL=
